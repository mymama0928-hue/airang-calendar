rules_version = '2';
// Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여 넣고 '게시'를 누르세요.
// 아래 이메일 3개를 실제 구글 계정 이메일로 바꿔야 해요. (이 파일은 깃허브에 올라가니 실제 이메일은 콘솔에만 넣으세요.)
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && request.auth.token.email in [
        'JISOO_EMAIL@gmail.com',
        'HARIM_EMAIL@gmail.com',
        'JIYOUNG_EMAIL@gmail.com'
      ];
    }
    match /{document=**} {
      allow read, write: if member();
    }
  }
}
